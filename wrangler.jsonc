{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reranklab",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // run the Worker on every request (not just non-asset paths) so the www→apex redirect applies to pages too
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "reranklab.com", "custom_domain": true },
    { "pattern": "www.reranklab.com", "custom_domain": true }
  ],
  // 5 contact submissions per IP per minute
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "reranklab-staging",
      "workers_dev": true,
      // MUST stay empty: routes are inherited, and without this staging seizes the production custom domains
      "routes": [],
      "vars": { "STAGING": "1" },
      "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
      "observability": { "enabled": true }
    }
  }
}
